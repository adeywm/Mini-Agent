# Copy to agents-server/.env. Never commit .env.

# Bedrock model used by the assistant (a model or inference-profile ID enabled in your account).
MINI_AGENT_MODEL_ID=global.anthropic.claude-sonnet-4-5-20250929-v1:0
MINI_AGENT_MODEL_REGION=ap-south-1
# AWS CLI profile used only to call Bedrock. Empty = default credential chain.
MINI_AGENT_BEDROCK_PROFILE=

# Where the SQLite file lives (relative to agents-server/).
MINI_AGENT_DATABASE_PATH=../database/mini-agent.db

# Managed AWS MCP Server (documentation and AWS API tools).
MINI_AGENT_AWS_MCP_ENDPOINT=https://aws-mcp.us-east-1.api.aws/mcp
MINI_AGENT_AWS_MCP_REGION=us-east-1

# GitHub MCP Server (remote, official).
MINI_AGENT_GITHUB_MCP_URL=https://api.githubcopilot.com/mcp/
