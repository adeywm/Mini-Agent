# Copy to backend/.env and update the database URL for your local PostgreSQL.
# This file contains examples only; keep real credentials in backend/.env.
INFRA_AGENT_APP_ENV=local
INFRA_AGENT_CONFIG_PATH=config/agent.toml
INFRA_AGENT_DATABASE_URL=postgresql://USERNAME:PASSWORD@localhost:5432/DATABASE_NAME

# Live access and writes are disabled until explicitly configured.
INFRA_AGENT_LIVE_READS=false
INFRA_AGENT_ENABLE_AWS_WRITES=false
INFRA_AGENT_ENABLE_GITHUB_WRITES=false
INFRA_AGENT_LOG_LEVEL=INFO

# Optional integrations:
# INFRA_AGENT_GITHUB_READ_TOKEN=
# INFRA_AGENT_GITHUB_WEBHOOK_SECRET=
# INFRA_AGENT_EVENTS_QUEUE_URL=
# INFRA_AGENT_EVENTS_PROFILE=
