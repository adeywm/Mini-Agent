# Documentation example only. Do not place secrets or real credentials here.
APP_ENV=local
LOG_LEVEL=INFO
WRITES_ENABLED=false
AWS_DEFAULT_REGION=ap-south-1
AWS_MCP_ENDPOINT=https://aws-mcp.us-east-1.api.aws/mcp
AWS_PROFILE=infra-agent-readonly
BEDROCK_REGION=us-east-1
BEDROCK_MODEL_ID=SET_MODEL_ID_FROM_OPERATOR
# Inject DATABASE_URL via local environment or secret manager; never commit a password.
DATABASE_URL=SET_FROM_SECRET_MANAGER
# Do not paste GitHub App private key into an environment file committed to Git.
GITHUB_APP_ID=SET_APP_ID
GITHUB_INSTALLATION_ID=SET_INSTALLATION_ID
