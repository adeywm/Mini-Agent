# Placeholders only. Never put credentials, tokens or keys in .env.
INFRA_AGENT_APP_ENV=local
INFRA_AGENT_CONFIG_PATH=config/agent.toml
# Live AWS reads stay off until you set this AND credential validation passes.
INFRA_AGENT_LIVE_READS=false
# Writes are not implemented in Phase 1; setting these to true makes the app refuse to start.
INFRA_AGENT_ENABLE_AWS_WRITES=false
INFRA_AGENT_ENABLE_SANDBOX_WRITES=false
INFRA_AGENT_LOG_LEVEL=INFO
