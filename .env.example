# Placeholders only. Never put credentials, tokens or keys in this file or in git.
INFRA_AGENT_APP_ENV=local
INFRA_AGENT_CONFIG_PATH=config/agent.toml
INFRA_AGENT_DATABASE_URL=postgresql://infra_agent@localhost:5432/infra_agent
# Live AWS reads stay off until set AND the read identity passes validation.
INFRA_AGENT_LIVE_READS=false
# Process-level write switches (also need config + account flags + policy + approval).
INFRA_AGENT_ENABLE_AWS_WRITES=false
INFRA_AGENT_ENABLE_GITHUB_WRITES=false
# Secrets: inject from a secret manager at runtime, not from this file.
# INFRA_AGENT_GITHUB_READ_TOKEN=
# INFRA_AGENT_GITHUB_WEBHOOK_SECRET=
# INFRA_AGENT_EVENTS_QUEUE_URL=https://sqs.<region>.amazonaws.com/<account>/infra-agent-events
# INFRA_AGENT_EVENTS_PROFILE=infra-agent-events
INFRA_AGENT_LOG_LEVEL=INFO
